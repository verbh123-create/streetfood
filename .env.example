# Local PostgreSQL or a Neon pooled PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Required for verification and password reset. Verify the sender domain in Resend.
RESEND_API_KEY=
RESEND_FROM=Street Taste Truck <hello@your-verified-domain.com>
APP_URL=http://localhost:3000
# Only set after reviewing initial seeded credentials; change them before public deployment.
